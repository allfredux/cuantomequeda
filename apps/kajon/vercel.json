{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "node --version",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": ["fra1"],
  "functions": { "api/*.mjs": { "maxDuration": 10 } },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/gateway" }
  ]
}
